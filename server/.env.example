# Copie este arquivo para ".env" e preencha.

# Porta do servidor no seu PC
PORTA=3100

# Banco PostgreSQL (o mesmo PostgreSQL 17 do PC, banco separado "faccliky")
DB_HOST=localhost
DB_PORT=5432
DB_NOME=faccliky
DB_USUARIO=postgres
DB_SENHA=sua_senha_do_postgres

# Chave secreta dos logins (texto aleatório e longo, mínimo 32 caracteres)
SEGREDO_TOKEN=troque_por_um_texto_aleatorio_bem_grande_aqui_123456

# Endereços do site que podem usar a API (separe por vírgula)
ORIGENS=https://faccliky.vercel.app,http://localhost:5500,http://127.0.0.1:5500

# BravoPay: segredo que vai na URL/cabeçalho do webhook
BRAVOPAY_SEGREDO_WEBHOOK=
DIAS_PREMIUM_POR_PAGAMENTO=30
